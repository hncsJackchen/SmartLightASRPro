#include "asr.h"
extern "C"{ void * __dso_handle = 0 ;}
#include "setup.h"
#include "HardwareSerial.h"
#include "myLib/asr_event.h"

// 串口定义：接 ESP-12F（UART 9600 8N1），TX=PB5(13)，RX=PB6(14)
#define PIN_SERIAL_TX  13
#define PIN_SERIAL_RX  14

uint32_t snid;
void ASR_CODE();

//{speak:思思-知性女声,vol:10,speed:10,platform:haohaodada}
//{playid:10001,voice:欢迎使用智能语音助手，用追随我心唤醒我。}
//{playid:10002,voice:我退下了，用追随我心唤醒我。}

// 读取一行串口回复（以 \n 结尾），超时返回已读内容；用于接收 ESP-12F 的响应帧
String readResp(uint32_t timeoutMs) {
  String s = "";
  uint32_t start = millis();
  while (millis() - start < timeoutMs) {
    while (Serial.available()) {
      char c = Serial.read();
      if (c == '\n') return s;
      if (c != '\r') s += c;
    }
    delay(1);
  }
  return s;
}

/*语音识别成功回调：按命令词经 UART 通知 ESP-12F，读回结果后播报对应语音*/
void ASR_CODE(){
  //唤醒时间设置必须在 ASR_CODE 中才有效
  set_state_enter_wakeup(20000);
  Serial.println("snid=" + String(snid));

  if(snid == 1 || snid == 3){
    // 打开灯光：发 ON，等待 ESP-12F 回传结果后播报
    Serial.println("ON");
    String resp = readResp(2000);
    if(resp.indexOf("ON_OK") >= 0){
      //{playid:10003,voice:已打开灯光}
      play_audio(10003);
    }else if(resp.indexOf("ON_SKIP") >= 0){
      //{playid:10005,voice:灯光已开}
      play_audio(10005);
    }else{
      //{playid:10007,voice:操作失败}
      play_audio(10007);
    }
  }else if(snid == 2 || snid == 4){
    // 关闭灯光：发 OFF，等待结果后播报
    Serial.println("OFF");
    String resp = readResp(2000);
    if(resp.indexOf("OFF_OK") >= 0){
      //{playid:10004,voice:已关闭灯光}
      play_audio(10004);
    }else if(resp.indexOf("OFF_SKIP") >= 0){
      //{playid:10006,voice:灯光已关}
      play_audio(10006);
    }else{
      //{playid:10007,voice:操作失败}
      play_audio(10007);
    }
  }
}

void hardware_init(){
  //需要操作系统启动后初始化的内容
  //音量范围1-7
  vol_set(7);
  //初始化串口0（Serial），TX=PB5(13), RX=PB6(14)，与 ESP-12F 通信并打印调试日志
  setPinFun(PIN_SERIAL_TX,SECOND_FUNCTION);
  setPinFun(PIN_SERIAL_RX,SECOND_FUNCTION);
  Serial.begin(9600);
  Serial.println("=== System Started ===");
  vTaskDelete(NULL);
}

void setup()
{
  //需要操作系统启动前初始化的内容
  //唤醒词最多5个，回复语可空，ID范围 0-9999
  //{ID:0,keyword:"唤醒词",ASR:"追随我心",ASRTO:"在的"}
  //{ID:1,keyword:"命令词",ASR:"打开灯光",ASRTO:""}
  //{ID:2,keyword:"命令词",ASR:"关闭灯光",ASRTO:""}
  //{ID:3,keyword:"命令词",ASR:"开灯",ASRTO:""}
  //{ID:4,keyword:"命令词",ASR:"关灯",ASRTO:""}
}





